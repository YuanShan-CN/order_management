# 数据库配置
DB_ROOT_PASSWORD=your_password_here
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=order_management
DB_HOST=db
DB_PORT=3306
DB_DSN=root:your_password_here@tcp(mysql:3306)/order_management?charset=utf8mb4&parseTime=True&loc=UTC

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOUR=24

# 服务器配置
SERVER_PORT=8080

# 定时任务配置
# TZ: 配置导出任务的目标时区（用于计算导出文件名的日期）
TZ=Asia/Shanghai